WHOAMI = """<!doctype html><html><head><meta charset="utf-8"><title>{title}</title>
<style>body{{margin:0;height:100vh;display:grid;place-items:center;background:{color};color:#fff;
font-family:-apple-system,BlinkMacSystemFont,sans-serif;text-align:center}}
h1{{font-size:88px;margin:0;letter-spacing:-.02em}}p{{font-size:24px;margin:8px 0;opacity:.9}}
small{{opacity:.7}}</style></head><body><div><h1>{alias}</h1><p>{email}</p>
<small>Chrome folder: {folder} &middot; you can close this window</small></div></body></html>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "chromep"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body)
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _q(self):
        return dict(urllib.parse.parse_qsl(urllib.parse.urlparse(self.path).query))

    def _ok_origin(self):
        # Only accept state-changing requests from our own page.
        origin = self.headers.get("Origin")
        return origin is None or origin == f"http://127.0.0.1:{self.server.server_port}"

    def do_GET(self):
        self.server.touch()
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/profiles":
            return self._send(200, merged()[0])
        if path == "/api/ping":
            return self._send(200, {"ok": True})
        if path == "/avatar":
            folder = self._q().get("folder", "")
            names = {p["folder"] for p in chrome_profiles()[0]}
            pic = CHROME_DIR / folder / "Google Profile Picture.png"
            if folder in names and pic.exists():
                return self._send(200, pic.read_bytes(), "image/png")
            return self._send(404, {"error": "no picture"})
        if path == "/whoami":
            folder = self._q().get("folder", "")
            p = next((p for p in merged()[0] if p["folder"] == folder), None)
            if not p:
                return self._send(404, "unknown profile", "text/plain")
            alias = p["alias"] or "(no name yet)"
            return self._send(200, WHOAMI.format(
                title=html.escape(f"{alias} · {p['email']}"), alias=html.escape(alias),
                email=html.escape(p["email"] or "not signed in"),
                folder=html.escape(folder), color=p["color"]), "text/html; charset=utf-8")
        self._send(404, {"error": "not found"})

    def do_POST(self):
        self.server.touch()
        if not self._ok_origin():
            return self._send(403, {"error": "bad origin"})
        path = urllib.parse.urlparse(self.path).path
        if path == "/api/identify":
            folder = self._q().get("folder", "")
            if folder not in {p["folder"] for p in chrome_profiles()[0]}:
                return self._send(400, {"error": "unknown folder"})
            url = f"http://127.0.0.1:{self.server.server_port}/whoami?folder={urllib.parse.quote(folder)}"
            launch(folder, [url])
            return self._send(200, {"ok": True})
        if path == "/api/save":
            n = int(self.headers.get("Content-Length", 0))
            rows = json.loads(self.rfile.read(n))
            err = apply_rows(rows)
            return self._send(200, {"ok": not err, "error": err})
        self._send(404, {"error": "not found"})


def apply_rows(rows):
    seen = {}
    for r in rows:
        a = r.get("alias", "").strip()
        if not a:
            continue
        if " " in a:
            return f"Name '{a}' has a space. Use something like '{a.replace(' ', '-')}'."
        if a.lower() in seen:
            return f"Name '{a}' is used twice."
        seen[a.lower()] = r["key"]
    cfg = load_config()
    for r in rows:
        e = cfg["profiles"].setdefault(r["key"], {})
        e["alias"] = r.get("alias", "").strip()
        e["note"] = r.get("note", "").strip()
        e["folder"] = r["folder"]
        e["email"] = r.get("email", "")
        if r.get("default"):
            cfg["default"] = r["key"]
    save_config(cfg)
    return None


class Server(ThreadingHTTPServer):
    idle_limit = 3 * 60  # page pings every 5s; Chrome may throttle hidden tabs to 1/min

    def touch(self):
        self.last = time.time()


def calibrate():
    srv = Server(("127.0.0.1", 0), Handler)
    srv.touch()
    url = f"http://127.0.0.1:{srv.server_port}/"
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    profiles, cfg = merged()
    host = next((p for p in profiles if p["default"]), None) or next(
        (p for p in profiles if p["last_used"]), profiles[0])
    launch(host["folder"], [url], app_mode=True)
    print(f"Calibration window open at {url}  (server stops ~3 min after you close the window, or Ctrl-C)")
    try:
        while time.time() - srv.last < Server.idle_limit:
            time.sleep(2)
    except KeyboardInterrupt:
        pass
    srv.shutdown()


# ---------- CLI ----------

def cmd_list():
    profiles, cfg = merged()
    w = max([len(p["alias"]) for p in profiles] + [5])
    for p in profiles:
        mark = "*" if p["default"] else " "
        print(f"{mark} {p['alias'] or '-':<{w}}  {p['email'] or '(not signed in)':<40}  {p['folder']}")
    if not cfg.get("default"):
        print("\nno default set. Run: chromep calibrate")


def looks_like_url(s):
    return "://" in s or s.startswith(("localhost", "127.0.0.1", "file:", "/")) or (
        "." in s and "@" not in s and not s.startswith("."))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "calibrate":
        calibrate()
    elif cmd == "list":
        cmd_list()
    elif cmd == "open":
        if not rest:
            die("usage: chromep open [WHO] URL...")
        who = None
        if len(rest) > 1 or not looks_like_url(rest[0]):
            who, rest = rest[0], rest[1:]
        p = resolve(who)
        launch(p["folder"], rest or ["about:blank"])
        print(f"opened in {p['alias'] or p['email']} ({p['email']}, {p['folder']})", file=sys.stderr)
    elif cmd == "default":
        if rest:
            p = resolve(rest[0])
            cfg = load_config()
            cfg["default"] = p["key"]
            save_config(cfg)
        p = resolve(None)
        print(f"{p['alias'] or '-'}  {p['email']}  {p['folder']}")
    elif cmd == "alias":
        if len(rest) != 2:
            die("usage: chromep alias WHO NAME")
        p = resolve(rest[0])
        profiles, _ = merged()
        rows = [dict(q, alias=(rest[1] if q["key"] == p["key"] else q["alias"])) for q in profiles]
        err = apply_rows(rows)
        if err:
            die(err)
        print(f"{rest[1]} -> {p['email']}")
    elif cmd == "whoami":
        p = resolve(rest[0] if rest else None)
        srv = Server(("127.0.0.1", 0), Handler)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        launch(p["folder"], [f"http://127.0.0.1:{srv.server_port}/whoami?folder={urllib.parse.quote(p['folder'])}"])
        time.sleep(4)
    else:
        die(f"unknown command '{cmd}'. Try: chromep help")


if __name__ == "__main__":
    main(sys.argv[1:])
