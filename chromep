#!/usr/bin/env python3
"""chromep: open URLs in the right Chrome profile, every time.

Profiles are identified by their signed-in email address, which is stable.
Chrome's folder names ("Profile 11") and display names ("Vishisht") are not
used as identity, so aliases survive renames and folder reshuffles.

  chromep calibrate            open the calibration window
  chromep list                 show profiles, aliases, emails
  chromep open [WHO] URL...    open URL(s) in profile WHO (alias, email, or folder)
                               WHO omitted: the default profile
  chromep default [WHO]        show or set the default profile
  chromep alias WHO NAME       set an alias from the shell
  chromep whoami WHO           open a banner page showing which profile that is
"""

import html
import json
import os
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

CHROME_DIR = Path.home() / "Library/Application Support/Google/Chrome"
LOCAL_STATE = CHROME_DIR / "Local State"
CONFIG_DIR = Path.home() / ".config/chromep"
CONFIG = CONFIG_DIR / "profiles.json"
APP = "Google Chrome"


# ---------- Chrome + config state ----------

def chrome_profiles():
    """Live list of profiles from Chrome's Local State."""
    state = json.loads(LOCAL_STATE.read_text())
    cache = state.get("profile", {}).get("info_cache", {})
    out = []
    for folder, info in cache.items():
        email = (info.get("user_name") or "").strip().lower()
        color = info.get("profile_highlight_color") or info.get("default_avatar_fill_color")
        out.append({
            "folder": folder,
            "email": email,
            "key": email or f"folder:{folder}",
            "chrome_name": info.get("name", ""),
            "gaia_name": info.get("gaia_name", ""),
            "color": "#%06x" % (color & 0xFFFFFF) if isinstance(color, int) else "#888888",
            "has_picture": (CHROME_DIR / folder / "Google Profile Picture.png").exists(),
        })
    out.sort(key=lambda p: (p["email"] == "", p["email"] or p["folder"]))
    return out, state.get("profile", {}).get("last_used", "")


def load_config():
    if CONFIG.exists():
        return json.loads(CONFIG.read_text())
    return {"default": None, "profiles": {}}


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    tmp.replace(CONFIG)


def merged():
    """Chrome's live profiles joined with saved aliases (by email key)."""
    profiles, last_used = chrome_profiles()
    cfg = load_config()
    changed = False
    for p in profiles:
        saved = cfg["profiles"].setdefault(p["key"], {})
        p["alias"] = saved.get("alias", "")
        p["note"] = saved.get("note", "")
        p["default"] = cfg.get("default") == p["key"]
        p["last_used"] = p["folder"] == last_used
        if saved.get("folder") != p["folder"]:  # remember latest folder, follow moves
            saved["folder"] = p["folder"]
            changed = True
    if changed:
        save_config(cfg)
    return profiles, cfg


def resolve(who):
    """alias > exact email > email prefix (before @) > folder name > unique substring."""
    profiles, cfg = merged()
    if who is None:
        if not cfg.get("default"):
            die("no default profile set. Run: chromep calibrate  (or chromep default WHO)")
        who = cfg["default"]
    w = who.strip().lower()
    tests = [
        lambda p: p["alias"].lower() == w,
        lambda p: p["key"] == w or p["email"] == w,
        lambda p: p["email"].split("@")[0] == w,
        lambda p: p["folder"].lower() == w,
        lambda p: w in p["email"] or w in p["alias"].lower(),
    ]
    for t in tests:
        hits = [p for p in profiles if t(p)]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            die(f"'{who}' is ambiguous: " + ", ".join(p["alias"] or p["email"] for p in hits))
    die(f"no Chrome profile matches '{who}'. Run: chromep list")


def die(msg):
    print(f"chromep: {msg}", file=sys.stderr)
    sys.exit(1)


def launch(folder, urls, app_mode=False):
    args = ["open", "-na", APP, "--args", f"--profile-directory={folder}"]
    if app_mode:
        args += [f"--app={urls[0]}"]
    else:
        args += ["--new-window", *urls]
    subprocess.run(args, check=True)


